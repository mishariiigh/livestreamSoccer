# PostgreSQL direct connection for administration and tooling.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Public values are safe to expose; Supabase Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only. Never prefix this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Server-only email mapped to the admin login alias `admin`.
ADMIN_LOGIN_EMAIL=admin@example.com

# NOTE: No football data provider key is required. The match schedule is entered
# by administrators in Admin → Schedule and stored in Supabase (`public.matches`).
# Any API_FOOTBALL_KEY you may still have configured is unused and can be deleted.

# Optional server-side provider credentials. Playback remains on the external CDN.
STREAMING_PROVIDER_API_URL=https://api.YOUR_PROVIDER.example
STREAMING_PROVIDER_API_KEY=YOUR_STREAMING_PROVIDER_API_KEY
STREAMING_PROVIDER_SECRET=YOUR_STREAMING_PROVIDER_SECRET

# Supabase Auth handles sessions in this application; reserved for future Auth.js use.
NEXTAUTH_SECRET=YOUR_RANDOM_SECRET

# Canonical site origin used by metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://mada.live

# Optional shared rate limiting across Vercel instances.
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_TOKEN